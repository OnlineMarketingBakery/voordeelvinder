---
// Site footer (Figma 60:496): purple band with logo, tagline, newsletter, three link columns
// and a white copyright bar. Contact values are placeholders until the client sends real ones;
// getSite() fails a production build while they are.
import ChevronRight from '../../assets/icons/chevron-footer.svg';
import MailContact from '../../assets/icons/mail-contact.svg';
import Mail from '../../assets/icons/mail.svg';
import Phone from '../../assets/icons/phone.svg';
import { consentSegments } from '../../lib/form/labels';
import { NEWSLETTER_ENDPOINT, type NewsletterCopy } from '../../lib/newsletter';
import { getSite, withYear } from '../../lib/site';
import { turnstileSiteKey } from '../../lib/turnstile';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Logo from '../ui/Logo.astro';

interface Props {
  /** A CTA band overlaps the top of the footer (product pages, About us). */
  overlap?: boolean;
}

const { overlap = false } = Astro.props;
const site = await getSite();
const { footer, contact } = site;
const { newsletter } = footer;
const consentParts = consentSegments(newsletter.consent.label, newsletter.consent.links);
const newsletterCopy: NewsletterCopy = {
  messages: newsletter.messages,
  errors: newsletter.errors,
};
// Turnstile protects the sign-up (brief §9.1); its script only loads once the e-mail field gets
// focus (src/scripts/newsletter-form.ts).
// On production without a real key the build fails (turnstileSiteKey throws).
const siteKey = turnstileSiteKey(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY, __SITE_ENV__);

const rowClass = 'inline-flex min-h-11 items-center gap-1.5 text-body text-white lg:min-h-[39px]';
const linkClass = `${rowClass} decoration-1 underline-offset-4 hover:underline`;
const columnHeading = 'text-title-lg lg:text-h3';
---

<footer class="surface-dark">
  <div
    class:list={['bg-purple-600 text-white', overlap ? 'pt-24 lg:pt-[182px]' : 'pt-12 lg:pt-14']}
  >
    <Container class="pb-10 lg:pb-[100px]">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between">
        <div class="flex flex-col items-start">
          <Logo label={footer.logoLabel} variant="footer" />
          <p class="mt-3 max-w-[556px] text-body text-white lg:mt-[9px]">{footer.tagline}</p>
        </div>

        <form
          class="relative w-full sm:max-w-[449px] lg:mt-[39px]"
          action={NEWSLETTER_ENDPOINT}
          method="post"
          data-newsletter={newsletter.enabled ? 'on' : 'off'}
          data-copy={JSON.stringify(newsletterCopy)}
          data-offline={newsletter.errors.network}
          data-reload={newsletter.reload.message}
          data-sitekey={siteKey}
        >
          <label for="newsletter-email" class="sr-only">
            {newsletter.label}
          </label>
          <div class="flex flex-col gap-3 sm:flex-row sm:[--focus-ring:var(--color-purple-500)] sm:items-center sm:gap-2 sm:rounded-full sm:bg-white sm:py-[7px] sm:pr-[9px] sm:pl-[22px]">
            <div class="flex h-14 items-center rounded-full bg-white pr-4 pl-[22px] [--focus-ring:var(--color-purple-500)] sm:h-auto sm:flex-1 sm:bg-transparent sm:pr-0 sm:pl-0">
              <Mail class="size-[26px] shrink-0 text-purple-500" aria-hidden="true" />
              <span class="mx-4 h-[30px] w-px shrink-0 bg-ink-900" aria-hidden="true"></span>
              <input
                id="newsletter-email"
                type="email"
                name="email"
                autocomplete="email"
                autocapitalize="none"
                spellcheck="false"
                required
                placeholder={newsletter.placeholder}
                disabled={!newsletter.enabled}
                class="h-11 min-w-0 flex-1 rounded-sm bg-transparent text-body text-ink-900 placeholder:text-ink-placeholder disabled:cursor-not-allowed sm:pr-4"
              />
            </div>
            <Button
              type="submit"
              variant="newsletter"
              size="newsletter"
              disabled={!newsletter.enabled}
            >
              {newsletter.button}
            </Button>
          </div>

          {/* Not in the design: the consent the endpoint requires, and the form's messages. */}
          <label class="mt-4 flex min-h-11 cursor-pointer items-start gap-3 text-sm text-white">
            <input
              type="checkbox"
              name="consent"
              value="true"
              required
              disabled={!newsletter.enabled}
              class="mt-px size-5 shrink-0 cursor-pointer accent-lime-400 disabled:cursor-not-allowed"
            />
            <span>
              {consentParts.map((part) =>
                part.href ? (
                  <a href={part.href} class="underline underline-offset-2 hover:no-underline">
                    {part.text}
                  </a>
                ) : (
                  part.text
                ),
              )}
            </span>
          </label>

          <p id="newsletter-suggestion" data-newsletter-suggestion hidden>
            <button
              type="button"
              class="min-h-11 text-left text-sm text-white underline underline-offset-4 hover:no-underline"
            ></button>
          </p>
          {/* Reads out a suggestion shown on blur, when focus has already left the field. */}
          <p class="sr-only" aria-live="polite" aria-atomic="true" data-newsletter-announce></p>

          <div data-newsletter-turnstile></div>

          {/* Always rendered (collapsed while empty), so its first message is announced too. */}
          <p
            id="newsletter-status"
            role="status"
            data-newsletter-status
            class="mt-2 rounded-md text-sm empty:mt-0 data-[tone=error]:bg-white data-[tone=error]:px-4 data-[tone=error]:py-2.5 data-[tone=error]:text-danger data-[tone=info]:text-white data-[tone=success]:bg-lime-400 data-[tone=success]:px-4 data-[tone=success]:py-2.5 data-[tone=success]:text-ink-900"
          ></p>
          {/* When the form's script can't load and only a reload helps (src/scripts/newsletter.ts). */}
          <p data-newsletter-reload hidden>
            <button
              type="button"
              class="min-h-11 text-left text-sm text-white underline underline-offset-4 hover:no-underline"
            >
              {newsletter.reload.button}
            </button>
          </p>

          {/* Honeypot (brief §9.1): off screen and out of the tab order, so only bots fill it. */}
          <div class="absolute -left-[10000px] size-px overflow-hidden" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </div>
        </form>
      </div>

      <div class="mt-10 h-px bg-white/34 lg:mt-12" aria-hidden="true"></div>

      <div class="grid gap-8 pt-8 md:grid-cols-2 lg:grid-cols-[344fr_425fr_401fr] lg:gap-0 lg:pt-14">
        <div>
          <h2 class={columnHeading}>{footer.links.heading}</h2>
          <ul class="mt-2 lg:mt-3">
            {footer.links.items.map((link) => (
              <li>
                <a href={link.href} class={linkClass}>
                  <ChevronRight class="size-3 shrink-0" aria-hidden="true" />
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="relative max-md:border-t max-md:border-white/34 max-md:pt-8 lg:pl-[122px]">
          <span
            class="absolute -top-14 bottom-[-100px] left-0 hidden w-px bg-linear-to-b from-white/34 to-white/0 lg:block"
            aria-hidden="true"
          ></span>
          <h2 class={columnHeading}>{footer.legal.heading}</h2>
          <ul class="mt-2 lg:mt-3">
            {footer.legal.items.map((link) => (
              <li>
                <a href={link.href} class={linkClass}>
                  <ChevronRight class="size-3 shrink-0" aria-hidden="true" />
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="relative max-lg:border-t max-lg:border-white/34 max-lg:pt-8 md:col-span-2 lg:col-span-1 lg:pl-[106px]">
          <span
            class="absolute -top-14 bottom-[-100px] left-0 hidden w-px bg-linear-to-b from-white/34 to-white/0 lg:block"
            aria-hidden="true"
          ></span>
          <h2 class={columnHeading}>{footer.contact.heading}</h2>
          <ul class="mt-2 lg:mt-3">
            <li>
              <a href={`mailto:${contact.email.value}`} class:list={[linkClass, 'gap-[9px]']}>
                <span
                  class="grid size-[25px] shrink-0 place-items-center rounded-full bg-lime-400 text-ink-900"
                  aria-hidden="true"
                >
                  <MailContact class="size-[13px]" />
                </span>
                {`${footer.contact.emailLabel} ${contact.email.value}`}
              </a>
            </li>
            <li>
              {contact.phone.e164 ? (
                <a href={`tel:${contact.phone.e164}`} class:list={[linkClass, 'gap-[9px]']}>
                  <span
                    class="grid size-[25px] shrink-0 place-items-center rounded-full bg-lime-400 text-ink-900"
                    aria-hidden="true"
                  >
                    <Phone class="size-[13px]" />
                  </span>
                  {`${footer.contact.phoneLabel} ${contact.phone.display}`}
                </a>
              ) : (
                <p class:list={[rowClass, 'gap-[9px]']}>
                  <span
                    class="grid size-[25px] shrink-0 place-items-center rounded-full bg-lime-400 text-ink-900"
                    aria-hidden="true"
                  >
                    <Phone class="size-[13px]" />
                  </span>
                  {`${footer.contact.phoneLabel} ${contact.phone.display}`}
                </p>
              )}
            </li>
          </ul>
        </div>
      </div>
    </Container>
  </div>

  <div class="bg-white">
    <Container class="flex min-h-[70px] flex-col justify-center gap-1 py-4">
      <p class="text-sm text-ink-900 lg:text-body">
        <strong class="font-semibold">{withYear(footer.copyright.holder)}</strong>
        {footer.copyright.rights}
      </p>
      {footer.copyright.company && <p class="text-sm text-ink-900">{footer.copyright.company}</p>}
    </Container>
  </div>
</footer>

<script>
  import '../../scripts/newsletter';
</script>
