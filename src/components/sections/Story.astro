---
// Story cards (About us 100:11–104:717): a centred header and two tinted 573×498 cards on a 7 px
// coloured lip, each with a 76 px icon tile, a 24/34 h3 (241 wide, so it wraps as designed),
// 16/24 paragraphs and one paragraph in the card's accent colour.
import type { StoryBlock } from '../../schemas/blocks/story';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';

type Props = StoryBlock;

const { id, title, intro, items } = Astro.props;
const headingId = `${id ?? 'story'}-title`;
const tones = {
  purple: {
    card: 'bg-lavender-50 shadow-[0_7px_0_var(--color-purple-600)]',
    tile: 'bg-purple-500 text-white',
    // The design's #6c5ce7 is 4.3:1 on lavender: the token for small purple text on lavender.
    accent: 'text-purple-700',
  },
  lime: {
    card: 'bg-lime-50 shadow-[0_7px_0_var(--color-lime-300)]',
    tile: 'bg-lime-300 text-ink-900',
    // The design's olive (#95a942) is 2.4:1 on the lime card: dark text keeps AA.
    accent: 'text-ink-800',
  },
};
---

<section {id} aria-labelledby={headingId} class="pt-16 md:pt-24 lg:pt-[135px]">
  <Container>
    <SectionHeading id={headingId} title={title} intro={intro} align="center" introClass="mt-4" />
    <div
      class:list={[
        'mt-10 grid gap-7 lg:mt-14',
        // One card (About us "Gratis? Waar zit dan het addertje?") sits centred at card width.
        items.length > 1 ? 'md:grid-cols-2' : 'mx-auto max-w-[37.5rem]',
      ]}
      data-reveal-stagger
    >
      {items.map((item) => (
        <article class:list={['lift rounded-3xl p-6 md:p-10 md:pb-12', tones[item.tone].card]}>
          <div
            class:list={[
              'grid size-16 place-items-center rounded-2xl md:size-[76px]',
              tones[item.tone].tile,
            ]}
          >
            <Icon name={item.icon} class="size-9 md:size-[42px]" />
          </div>
          <h3 class="mt-6 max-w-[241px] text-title-lg text-ink-900 md:mt-[30px]">{item.title}</h3>
          <div class="mt-5 space-y-5 text-body text-ink-600 md:mt-6 md:space-y-[26px]">
            {item.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {item.accent && <p class={tones[item.tone].accent}>{item.accent}</p>}
          </div>
        </article>
      ))}
    </div>
  </Container>
</section>
