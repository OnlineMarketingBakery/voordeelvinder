---
// "Is VoordeelVinder iets voor mij?" (About us 111:895–111:940): persona cards on a purple panel.
import type { PersonasBlock } from '../../schemas/blocks/personas';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';

type Props = PersonasBlock;

const { id, title, intro, items } = Astro.props;
const headingId = `${id ?? 'personas'}-title`;
---

<section {id} aria-labelledby={headingId} class="pt-16 md:pt-24 lg:pt-32">
  <Container>
    <div class="surface-dark rounded-3xl bg-purple-600 px-4 py-12 md:px-8 lg:px-10 lg:py-16">
      <SectionHeading id={headingId} title={title} intro={intro} align="center" onDark />
      <div class="mt-10 grid gap-5 md:grid-cols-3 lg:mt-12" data-reveal-stagger>
        {items.map((item) => (
          <article class="flex flex-col rounded-2xl bg-white p-5 text-ink-900 shadow-[0_6px_0_var(--color-lime-400)] md:p-6">
            <span class="self-start rounded-full bg-purple-500 px-3 py-1 text-label-sm text-white">
              {item.badge}
            </span>
            <h3 class="mt-4 text-title-sm">{item.statement}</h3>
            <p class="mt-3 text-sm text-ink-600">{item.occasion}</p>
            <blockquote class="mt-5 rounded-xl bg-lavender-50 p-4 text-sm text-ink-800">
              {item.quote}
            </blockquote>
            <p class="mt-5 text-sm text-purple-700">{item.benefit}</p>
            <div class="mt-auto pt-6">
              <Button href={item.cta.href} size="sm" icon="arrow-up-right" fullWidth>
                {item.cta.label}
              </Button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </Container>
</section>
