---
// Product card on the homepage (Figma 66:861 zonnepanelen, 67:893 thuisbatterij): pill and CTA
// on one row, h2, body, feature cards on accent plates, and an illustration standing on the
// accent bar in the bottom-right corner. Below md everything stacks (CTA full width after the
// body, illustration last); on md the illustration stays in flow after the list; from lg it
// sits absolutely in the corner, behind the text column.
//
// Signature morph (brief §6.1, docs/MOTION.md, Phase 7): the card carries `data-morph` so the
// page-transition script can set `view-transition-name: form-card` on the card whose CTA was
// clicked. The name is never set here: two cards share the page and names must be unique.
import type { ProductSpotlightBlock } from '../../schemas/blocks/productSpotlight';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import CopyText from '../ui/CopyText.astro';
import Illustration from '../ui/Illustration.astro';
import SectionPill from '../ui/SectionPill.astro';

type Props = ProductSpotlightBlock;

const { id, product, tone, eyebrow, title, body, cta, items, image } = Astro.props;
const headingId = `${id ?? `spotlight-${product}`}-title`;

const tones = {
  // Figma #f8fceb card, #b7e137 bar and plates, lime pill and lime CTA.
  lime: {
    card: 'bg-lime-50 border-lime-400',
    plate: 'before:bg-lime-400',
    pill: 'lime',
    button: 'lime',
  },
  // Figma #f2f0ff card, #6c5ce7 bar and plates, lavender pill and purple CTA.
  lavender: {
    card: 'bg-lavender-100 border-purple-500',
    plate: 'before:bg-purple-500',
    pill: 'lavender',
    button: 'purple',
  },
} as const;
const look = tones[tone];

const pillIcon = product === 'zonnepanelen' ? 'solar-panel' : 'car-battery';

// Illustration width per product at xl (Figma 508×398 and 524×534). On lg the art shrinks so it
// never runs under the ≈600px text column (70 padding + 16 indent + 508 cards).
const art = {
  zonnepanelen: { lg: 'lg:w-[min(31.75rem,calc(100%-37.5rem))]', xl: 508 },
  thuisbatterij: { lg: 'lg:w-[min(32.75rem,calc(100%-37.5rem))]', xl: 524 },
}[product];
---

<section
  {id}
  aria-labelledby={headingId}
  data-block="productSpotlight"
  class="pt-16 md:pt-24 lg:pt-32 [[data-block=productSpotlight]+&]:pt-10 md:[[data-block=productSpotlight]+&]:pt-16 lg:[[data-block=productSpotlight]+&]:pt-[90px]"
>
  <Container>
    <div
      class:list={[
        'relative isolate overflow-hidden rounded-t-xl rounded-b-sm border-b-10 px-5 pt-8 md:px-10 md:pt-10 lg:ps-[70px] lg:pe-[66px] lg:pt-[50px] lg:pb-[72px]',
        look.card,
      ]}
      data-morph="form-card"
      data-reveal
    >
      <div class="relative z-10 md:grid md:grid-cols-[minmax(0,1fr)_auto] md:items-center md:gap-x-6">
        <SectionPill
          label={eyebrow}
          tone={look.pill}
          icon={pillIcon}
          class="md:col-start-1 md:row-start-1 md:justify-self-start"
        />
        <h2
          id={headingId}
          class="mt-4 max-w-[42rem] text-h3 text-ink-900 md:col-span-2 md:text-h2 lg:mt-5"
        >
          {title}
        </h2>
        <CopyText
          copy={body}
          class="mt-4 max-w-[42rem] text-body text-ink-600 md:col-span-2 md:text-body-lg lg:mt-5"
        />
        <div class="mt-6 md:col-start-2 md:row-start-1 md:mt-0">
          <Button
            href={cta.href}
            variant={look.button}
            size="md"
            icon="arrow-up-right"
            glow="none"
            class="w-full md:w-auto"
          >
            {cta.label}
          </Button>
        </div>
        <ul
          role="list"
          class="ms-2 mt-8 flex flex-col gap-3.5 md:col-span-2 lg:ms-4 lg:max-w-[31.75rem]"
          data-reveal-stagger
        >
          {items.map((item) => (
            <li
              class:list={[
                // The accent plate: only its visible 8px strip, left of the card (Figma draws a
                // full plate behind the card, offset 8px left and inset 25px top and bottom).
                'group relative flex before:absolute before:inset-y-[25px] before:right-full before:w-2 before:rounded-l-xs',
                look.plate,
              ]}
            >
              <div class="lift w-full rounded-xl bg-white px-5 py-5 shadow-soft md:px-8 md:pt-6 md:pb-6">
                <h3 class="text-title-sm text-ink-900">{item.title}</h3>
                <p class="mt-2 text-sm text-ink-600">{item.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div
        class:list={[
          'ms-auto -me-5 mt-8 w-[85%] md:-me-10 md:w-[min(26rem,70%)] lg:absolute lg:right-0 lg:bottom-0 lg:m-0',
          art.lg,
        ]}
        data-reveal
      >
        <Illustration
          src={image.src}
          alt={image.alt}
          widths={[320, 416, 508, 524, 640, 681]}
          sizes={`(min-width: 1280px) ${art.xl}px, (min-width: 1024px) calc(100vw - 648px), (min-width: 768px) 416px, 85vw`}
          class="block h-auto w-full"
        />
      </div>
    </div>
  </Container>
</section>
