---
// "De mensen achter VoordeelVinder" (About us 113:944–113:1006): photo cards on purple and lime
// gradients with a name and a role. Placeholder people fail a production build (pages.ts).
import type { TeamBlock } from '../../schemas/blocks/team';
import Container from '../ui/Container.astro';
import Illustration from '../ui/Illustration.astro';
import SectionHeading from '../ui/SectionHeading.astro';

type Props = TeamBlock;

const { id, title, intro, members } = Astro.props;
const headingId = `${id ?? 'team'}-title`;
const gradients = ['from-purple-500 to-lavender-100', 'from-lime-300 to-lime-50'];
---

<section {id} aria-labelledby={headingId} class="pt-16 md:pt-24 lg:pt-32">
  <Container>
    <SectionHeading id={headingId} title={title} intro={intro} align="center" />
    <ul
      role="list"
      class="mx-auto mt-10 grid max-w-[920px] gap-6 sm:grid-cols-3 lg:mt-14"
      data-reveal-stagger
    >
      {members.map((member, index) => (
        <li class="text-center">
          <div
            class:list={[
              'overflow-hidden rounded-2xl bg-linear-to-b',
              gradients[index % gradients.length],
            ]}
          >
            <Illustration
              src={member.photo.src}
              alt={member.photo.alt}
              widths={[280, 420]}
              sizes="(min-width: 640px) 280px, 90vw"
              class="aspect-[4/5] h-auto w-full object-cover object-top"
            />
          </div>
          <p class="mt-4 text-title-sm text-ink-900">{member.name}</p>
          <p class="mt-1 text-sm text-ink-600">{member.role}</p>
        </li>
      ))}
    </ul>
  </Container>
</section>
