---
// "Waar we voor staan" (About us 100:303–104:741): header and mascot on the left, badge cards on
// the right, over the cloud background.
import type { ValuesBlock } from '../../schemas/blocks/values';
import Container from '../ui/Container.astro';
import Illustration from '../ui/Illustration.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import CloudsBackground from './parts/CloudsBackground.astro';

type Props = ValuesBlock;

const { id, title, intro, image, items } = Astro.props;
const headingId = `${id ?? 'values'}-title`;
---

<section
  {id}
  aria-labelledby={headingId}
  class="relative isolate mt-16 py-16 md:mt-24 lg:mt-32 lg:py-24"
>
  <CloudsBackground />
  <Container class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:items-center lg:gap-16">
    <div>
      <SectionHeading id={headingId} title={title} intro={intro} />
      <Illustration
        src={image.src}
        alt={image.alt}
        widths={[280, 420, 560]}
        sizes="(min-width: 1024px) 420px, 280px"
        class="mx-auto mt-8 h-auto w-[280px] lg:mt-12 lg:w-[420px]"
      />
    </div>
    <div class="grid gap-6" data-reveal-stagger>
      {items.map((item) => (
        <article class="lift rounded-2xl bg-white p-6 shadow-[0_6px_0_var(--color-purple-500)] md:p-8">
          <span class="inline-block rounded-full bg-lime-300 px-3 py-1 text-label-sm text-ink-900">
            {item.badge}
          </span>
          <h3 class="mt-4 text-title text-ink-900">{item.title}</h3>
          <p class="mt-3 text-sm text-ink-600 md:text-body">{item.body}</p>
        </article>
      ))}
    </div>
  </Container>
</section>
