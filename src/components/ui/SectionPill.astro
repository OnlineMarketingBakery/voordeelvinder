---
// The eyebrow badge above section headings: a tinted outer pill holding a white icon circle
// and a white label pill (Figma 60:21, 60:35, 66:866, 67:896).
import Icon from './Icon.astro';

export type PillTone = 'lime' | 'purple' | 'lavender';
export type PillIcon = 'info' | 'solar-panel' | 'car-battery';

interface Props {
  label: string;
  /** lime: lime tint (most sections); purple: white outer, lavender inner (FAQ); lavender: purple tint (battery). */
  tone?: PillTone;
  icon?: PillIcon;
  class?: string;
}

const { label, tone = 'lime', icon = 'info', class: className } = Astro.props;

const outer = { lime: 'bg-lime-400/28', purple: 'bg-white', lavender: 'bg-purple-500/10' }[tone];
const inner = tone === 'purple' ? 'bg-lavender-50' : 'bg-white';
// Figma: the icon is ink on the lime and lavender pills, purple on the FAQ pill.
const iconColour = tone === 'purple' ? 'text-purple-500' : 'text-ink-900';
const iconName = {
  info: 'info-circle',
  'solar-panel': 'solar-panel',
  'car-battery': 'car-battery',
}[icon];
---

<p
  class:list={[
    'inline-flex max-w-full items-center gap-1 rounded-full p-1.5 lg:p-2',
    outer,
    className,
  ]}
>
  <span
    class:list={[
      'grid size-9 shrink-0 place-items-center rounded-full lg:size-11',
      inner,
      iconColour,
    ]}
    aria-hidden="true"
  >
    <Icon name={iconName} class="size-6 lg:size-7" />
  </span>
  <span
    class:list={[
      // Smaller below sm, so "VoordeelVinder versus anderen" fits a 360 px phone on one line.
      'min-w-0 rounded-full px-3 py-1 text-body text-ink-800 sm:px-4 sm:text-body-lg lg:px-5 lg:py-[7px] lg:text-lead',
      inner,
    ]}
  >
    {label}
  </span>
</p>
