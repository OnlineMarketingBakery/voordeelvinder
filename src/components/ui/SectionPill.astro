---
// The eyebrow badge above section headings: a tinted outer pill holding a white icon circle
// and a white label pill (Figma 60:21, 60:35, 66:866).
import InfoCircle from '../../assets/icons/info-circle.svg';

interface Props {
  label: string;
  /** lime: lime-tinted outer pill (most sections); purple: white outer, lavender inner (FAQ). */
  tone?: 'lime' | 'purple';
  class?: string;
}

const { label, tone = 'lime', class: className } = Astro.props;
const inner = tone === 'lime' ? 'bg-white' : 'bg-lavender-50';
---

<p
  class:list={[
    'inline-flex items-center gap-1 rounded-full p-1.5 lg:p-2',
    tone === 'lime' ? 'bg-lime-400/28' : 'bg-white',
    className,
  ]}
>
  <span
    class:list={['grid size-9 place-items-center rounded-full text-purple-500 lg:size-11', inner]}
    aria-hidden="true"
  >
    <InfoCircle class="size-6 lg:size-7" />
  </span>
  <span
    class:list={[
      'rounded-full px-4 py-1 text-body-lg text-ink-800 lg:px-5 lg:py-[7px] lg:text-lead',
      inner,
    ]}
  >
    {label}
  </span>
</p>
