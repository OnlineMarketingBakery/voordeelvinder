---
// Logo lockup: the fox badge plus the outlined "Voordeelvinder" wordmark, linking home.
// Served as cacheable image files (the badge is 23 KB) rather than inlined on every page.
import { Image } from 'astro:assets';

import badge from '../../assets/brand/logo-badge.svg';
import wordmarkWhite from '../../assets/brand/logo-wordmark-white.svg';
import wordmark from '../../assets/brand/logo-wordmark.svg';

interface Props {
  /** Accessible name of the link (the images themselves are decorative). */
  label: string;
  /** header: 54px lockup on ink wordmark; footer: 87px lockup with a white wordmark. */
  variant?: 'header' | 'footer';
}

const { label, variant = 'header' } = Astro.props;
const isFooter = variant === 'footer';
---

<a
  href="/"
  aria-label={label}
  class:list={[
    'inline-flex shrink-0 items-end rounded-md',
    isFooter ? 'gap-[5px]' : 'gap-[3px] self-start lg:mt-1',
  ]}
>
  <Image
    src={badge}
    alt=""
    loading="eager"
    class:list={isFooter ? 'h-[66px] w-auto lg:h-[87px]' : 'h-[46px] w-auto lg:h-[54px]'}
  />
  <Image
    src={isFooter ? wordmarkWhite : wordmark}
    alt=""
    loading="eager"
    class:list={
      isFooter
        ? 'mb-[14px] h-5 w-auto lg:mb-[18px] lg:h-[27px]'
        : 'mb-[9px] h-[14px] w-auto lg:mb-[11px] lg:h-[17px]'
    }
  />
</a>
