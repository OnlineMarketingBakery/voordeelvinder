{
  "switches": { "gas": true },
  "steps": [
    {
      "id": "product",
      "title": "Wat wil je vergelijken?",
      "visibleIf": { "!": [{ "var": "derived.preselected" }] },
      "fields": [
        {
          "id": "product_choice",
          "type": "single_choice",
          "required": true,
          "payload": "none",
          "options": [
            {
              "code": "electricity",
              "label": "Elektriciteit",
              "icon": "renewable-energy",
              "product": "energie",
              "sets": { "energy_type": "electricity" }
            },
            {
              "code": "gas",
              "label": "Gas",
              "icon": "home",
              "product": "energie",
              "sets": { "energy_type": "gas" },
              "requires": "gas"
            },
            {
              "code": "both",
              "label": "Elektriciteit + gas",
              "icon": "home-bolt",
              "product": "energie",
              "sets": { "energy_type": "both" },
              "requires": "gas"
            },
            {
              "code": "zonnepanelen",
              "label": "Zonnepanelen",
              "icon": "solar-panel",
              "product": "zonnepanelen"
            },
            {
              "code": "thuisbatterij",
              "label": "Thuisbatterij",
              "icon": "car-battery",
              "product": "thuisbatterij"
            }
          ]
        }
      ]
    },
    {
      "id": "postcode",
      "title": "Wat is je postcode?",
      "fields": [
        {
          "id": "postcode",
          "type": "postcode",
          "required": true,
          "payload": "derived",
          "placeholder": "Voer je postcode in"
        },
        { "id": "is_business", "type": "checkbox", "label": "Dit is een zakelijk adres." },
        {
          "id": "business_electricity_band",
          "type": "single_choice",
          "label": "Elektriciteit: wat is je geschat jaarverbruik?",
          "required": true,
          "visibleIf": {
            "and": [
              { "var": "is_business" },
              { "in": [{ "var": "energy_type" }, ["electricity", "both"]] }
            ]
          },
          "options": [
            { "code": "under_100k", "label": "Minder dan 100.000 kWh per jaar" },
            { "code": "over_100k", "label": "Meer dan 100.000 kWh per jaar" }
          ]
        },
        {
          "id": "business_gas_band",
          "type": "single_choice",
          "label": "Aardgas: wat is je geschat jaarverbruik?",
          "required": true,
          "visibleIf": {
            "and": [{ "var": "is_business" }, { "in": [{ "var": "energy_type" }, ["gas", "both"]] }]
          },
          "options": [
            { "code": "under_100k", "label": "Minder dan 100.000 kWh per jaar" },
            { "code": "over_100k", "label": "Meer dan 100.000 kWh per jaar" }
          ]
        }
      ]
    },
    {
      "id": "knows_consumption",
      "title": "Ken je je jaarlijks energieverbruik?",
      "fields": [{ "id": "knows_consumption", "type": "yes_no", "required": true }]
    },
    {
      "id": "household",
      "title": "Hoeveel personen wonen er in je woning?",
      "fields": [
        {
          "id": "household_size",
          "type": "select",
          "required": true,
          "placeholder": "Selecteer het aantal personen",
          "options": [
            { "code": "1", "label": "1 persoon" },
            { "code": "2", "label": "2 personen" },
            { "code": "3", "label": "3 personen" },
            { "code": "4", "label": "4 personen" },
            { "code": "5_plus", "label": "5 of meer" }
          ]
        },
        {
          "id": "home_type",
          "type": "select",
          "label": "Wat voor woning heb je?",
          "required": true,
          "placeholder": "Selecteer woningtype",
          "options": [
            { "code": "apartment", "label": "Appartement" },
            { "code": "terraced", "label": "Rijwoning (gesloten bebouwing)" },
            { "code": "semi_detached", "label": "Halfopen bebouwing" },
            { "code": "detached", "label": "Open bebouwing" }
          ]
        }
      ]
    },
    {
      "id": "appliances",
      "title": "Heb je een warmtepomp?",
      "fields": [
        { "id": "heat_pump", "type": "yes_no", "required": true },
        {
          "id": "electric_car",
          "type": "yes_no",
          "label": "Heb je een elektrische wagen?",
          "required": true
        }
      ]
    },
    {
      "id": "contact",
      "title": "Jouw gegevens",
      "fields": [
        {
          "id": "first_name",
          "type": "text",
          "label": "Voornaam",
          "placeholder": "Vul hier je voornaam in",
          "required": true,
          "payload": "contact",
          "autocomplete": "given-name"
        },
        {
          "id": "last_name",
          "type": "text",
          "label": "Achternaam",
          "placeholder": "Vul hier je achternaam in",
          "required": true,
          "payload": "contact",
          "autocomplete": "family-name"
        },
        {
          "id": "phone",
          "type": "phone",
          "label": "Telefoonnummer",
          "placeholder": "478 12 34 56",
          "required": true,
          "payload": "contact"
        },
        {
          "id": "email",
          "type": "email",
          "label": "E-mail",
          "placeholder": "example@email.com",
          "required": true,
          "payload": "contact"
        },
        {
          "id": "call_moment",
          "type": "day_slot",
          "label": "Wanneer mogen we je bellen?",
          "dayLabel": "Dag",
          "slotLabel": "Tijdstip",
          "required": true,
          "payload": "call_preference",
          "days": [
            { "code": "mon", "label": "Maandag" },
            { "code": "tue", "label": "Dinsdag" },
            { "code": "wed", "label": "Woensdag" },
            { "code": "thu", "label": "Donderdag" },
            { "code": "fri", "label": "Vrijdag" }
          ],
          "slots": [
            { "code": "09-10", "label": "09:00–10:00" },
            { "code": "10-11", "label": "10:00–11:00" },
            { "code": "11-12", "label": "11:00–12:00" },
            { "code": "12-13", "label": "12:00–13:00" },
            { "code": "13-14", "label": "13:00–14:00" },
            { "code": "14-15", "label": "14:00–15:00" },
            { "code": "15-16", "label": "15:00–16:00" }
          ]
        },
        {
          "id": "terms",
          "type": "consent",
          "label": "Ik ga akkoord met de algemene voorwaarden en het privacybeleid en geef toestemming dat VoordeelVinder en haar partners mij contacteren over mijn vergelijking.",
          "links": [
            { "text": "algemene voorwaarden", "href": "/algemene-voorwaarden" },
            { "text": "privacybeleid", "href": "/privacybeleid" }
          ],
          "required": true,
          "payload": "consent"
        },
        {
          "id": "newsletter",
          "type": "checkbox",
          "label": "Ik wil tips en aanbiedingen via e-mail ontvangen.",
          "payload": "consent"
        }
      ]
    }
  ]
}
