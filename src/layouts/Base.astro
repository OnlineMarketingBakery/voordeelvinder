---
import { Font } from 'astro:assets';

import defaultOgImage from '../assets/og/default.png';
import { getSite } from '../lib/site';
import { isIndexable } from '../lib/seo/indexing';
import { jsonLd, pageTitle } from '../lib/seo/structured-data';
import { testModeScript } from '../lib/test-mode';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string | undefined;
  /** Keep this page out of search results even in production (thank-you pages, /l/*). */
  noindex?: boolean;
  /**
   * Link rel=canonical (and og:url) to this path. Off for the 404, which is served at any
   * unknown URL: its own path (/404) is not a page to point search engines at.
   */
  canonical?: boolean;
  /**
   * The canonical path when it isn't the request's own: on-demand pages answer with and without
   * the trailing slash, and point both at the one the sitemap lists.
   */
  canonicalPath?: string | undefined;
  /** schema.org objects for this page (JSON-LD). */
  structuredData?: object[];
  /** The share image; default the site's (src/assets/og/default.png). */
  ogImage?: { src: string; width: number; height: number; alt: string } | undefined;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  noindex = false,
  canonical: hasCanonical = true,
  canonicalPath,
  structuredData = [],
  ogImage: pageOgImage,
  ogType = 'website',
} = Astro.props;
const site = await getSite();

const fullTitle = pageTitle(title, site.name, site.seo.titleTemplate);
const metaDescription = description ?? site.seo.defaultDescription;
const canonical = hasCanonical
  ? new URL(canonicalPath ?? Astro.url.pathname, Astro.site)
  : undefined;
const og = pageOgImage ?? {
  src: defaultOgImage.src,
  width: defaultOgImage.width,
  height: defaultOgImage.height,
  alt: site.seo.ogImageAlt,
};
const ogImage = new URL(og.src, Astro.site);

// Only production is indexable (brief §4.5); Nginx also sends X-Robots-Tag on staging.
const robots = noindex || !isIndexable(__SITE_ENV__) ? 'noindex, nofollow' : undefined;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/*
      The cross-document view-transition opt-in (brief §6.1, docs/MOTION.md), inline and first so
      it holds from the very first style update. In the external stylesheet only, Chromium can
      evaluate the opt-in before that file has arrived (a page served from the prefetch cache),
      find none and abort the transition with "ViewTransition opt-in disabled".
    */}
    <style is:inline>
      @view-transition {
        navigation: auto;
      }
    </style>
    {/* Test mode (brief §9.4): ?test=1 is kept for the session and shows the badge below. */}
    <script is:inline set:html={testModeScript} />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />

    <Font cssVariable="--font-bricolage" preload />
    {structuredData.map((data) => (
      <script type="application/ld+json" set:html={jsonLd(data)} />
    ))}
    <slot name="head" />
  </head>
  <body class="font-sans">
    <slot />
    {/*
      Shown only while test mode is on (data-test-mode on <html>, set by the script above before
      the first paint); display:none otherwise, so screen readers skip it too. Not focusable.
      A vertical tab on the left edge, 16px wide: it fits the page gutter at 390px, so it never
      covers a button or text (a corner badge sat on the form's "Terug" on mobile).
    */}
    <p
      data-test-badge
      class="pointer-events-none fixed bottom-3 left-0 z-50 hidden w-4 rotate-180 rounded-l-sm bg-ink-900 py-2 text-center text-[10px] leading-4 font-bold tracking-wide text-white [writing-mode:vertical-rl] in-data-test-mode:block"
    >
      {site.testMode.badge}
    </p>
  </body>
</html>
