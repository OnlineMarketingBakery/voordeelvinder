---
// /blog/<slug>: one page per published post in src/content/blog (none yet: CONTENT-TODO 2.14).
import BlogPost from '../../layouts/BlogPost.astro';
import { getPosts, neighbours, type Post, relatedPosts } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, ...neighbours(posts, post.id), related: relatedPosts(posts, post) },
  }));
}

interface Props {
  post: Post;
  newer: Post | undefined;
  older: Post | undefined;
  related: Post[];
}
---

<BlogPost {...Astro.props} />
