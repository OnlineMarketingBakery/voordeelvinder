---
// Screen 2, the results (Figma 221:5711, ADR 0013): placeholder data, off in production.
import { getImage } from 'astro:assets';

import OrderLayout from '../../../components/order/OrderLayout.astro';
import ResultsIsland from '../../../components/order/ResultsIsland';
import { image } from '../../../lib/assets';
import { fill } from '../../../lib/comparison/copy';
import { orderPageData } from '../../../lib/comparison/page-data';
import { orderPreview } from '../../../lib/comparison/preview';

export const prerender = false;

if (!orderPreview(__SITE_ENV__)) return new Response(null, { status: 404 });
const { copy, comparison, labels } = await orderPageData();
const foxMeta = image('mascot/fox-cheer-document');
const foxImage = await getImage({ src: foxMeta, width: 240, format: 'webp' });
const fox = {
  src: foxImage.src,
  width: 240,
  height: Math.round((foxMeta.height / foxMeta.width) * 240),
};
const r = copy.results;
---

<OrderLayout
  title={r.title}
  highlight={r.highlight}
  subtitle={fill(r.subtitle, { count: comparison.offers.length })}
>
  <ResultsIsland client:load copy={copy} comparison={comparison} labels={labels} fox={fox} />
</OrderLayout>
