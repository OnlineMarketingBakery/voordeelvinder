---
// Screen 2, the results (Figma 221:5711, ADR 0013): /vergelijken/<product>/resultaten, one route
// for every product. Only the products in RESULTS_PRODUCTS have one (energy today); the others,
// and every product in production, answer 404. Placeholder data until the tariff API.
import { getImage } from 'astro:assets';

import OrderLayout from '../../../components/order/OrderLayout.astro';
import ResultsIsland from '../../../components/order/ResultsIsland';
import { image } from '../../../lib/assets';
import { fill } from '../../../lib/comparison/copy';
import { orderPageData } from '../../../lib/comparison/page-data';
import { hasResults, orderPreview } from '../../../lib/comparison/preview';

export const prerender = false;

const product = Astro.params.product ?? '';
if (!orderPreview(__SITE_ENV__) || !hasResults(product)) {
  return new Response(null, { status: 404 });
}
const { copy, comparison, labels } = await orderPageData(product);
const foxMeta = image('mascot/fox-cheer-document');
const foxImage = await getImage({ src: foxMeta, width: 240, format: 'webp' });
const fox = {
  src: foxImage.src,
  width: 240,
  height: Math.round((foxMeta.height / foxMeta.width) * 240),
};
const r = copy.results;
---

<OrderLayout
  title={r.title}
  highlight={r.highlight}
  subtitle={fill(r.subtitle, { count: comparison.offers.length })}
>
  <ResultsIsland client:load copy={copy} comparison={comparison} labels={labels} fox={fox} />
</OrderLayout>
