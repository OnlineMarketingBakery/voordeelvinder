---
import { getEntry } from 'astro:content';

import Sections from '../components/sections/Sections.astro';
import Page from '../layouts/Page.astro';
import { organization, website } from '../lib/seo/structured-data';
import { getSite } from '../lib/site';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('src/content/pages/home.json is missing');

const site = await getSite();
const siteUrl = new URL('/', Astro.site);
const structuredData = [
  organization({ name: site.name, url: siteUrl, logo: new URL('/icon-512.png', Astro.site) }),
  website({ name: site.name, url: siteUrl, inLanguage: site.locale }),
];
---

<Page title={page.data.seo.title} description={page.data.seo.description} {structuredData}>
  <Sections sections={page.data.sections} />
</Page>
