---
import { getEntry } from 'astro:content';

import Sections from '../components/sections/Sections.astro';
import Page from '../layouts/Page.astro';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('src/content/pages/home.json is missing');
---

<Page title={page.data.seo.title} description={page.data.seo.description}>
  <Sections sections={page.data.sections} />
</Page>
