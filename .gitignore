# dependencies and build output (no trailing slash: also matches a symlinked node_modules)
node_modules
dist/
dist.*/
.astro/
.cache/

# environment (secrets live only in Ploi's .env)
.env
.env.*
!.env.example

# certbot webroot on the server (Ploi web directory is /public)
public/.well-known/

# test output
coverage/
playwright-report/
test-results/
blob-report/

# local lead backups (never commit leads)
lead-backups/
*.jsonl

# agent worktrees and local settings (Claude Code)
.claude/worktrees/
.claude/settings.local.json

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
