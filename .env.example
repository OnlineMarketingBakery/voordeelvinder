# Copy to .env for local development. Real values live only in Ploi's "Edit environment".
# SITE_ENV and PUBLIC_* are read at build time: change them, then rebuild/redeploy.
# An empty value (NAME=) counts as not set.

# local | ci | staging | production — every lead is a test lead unless this is "production".
SITE_ENV=local
HOST=127.0.0.1
PORT=4321
PUBLIC_SITE_URL=http://localhost:4321

# Lead backups (brief §9.1): outside the web root, one YYYY-MM.jsonl file per month.
LEAD_BACKUP_DIR=./lead-backups
RATE_LIMIT_PER_HOUR=10

# n8n (brief §9.1). Optional except on production: without a lead webhook, leads are only
# backed up. Locally use a mock (tests/support/mock-n8n.ts), never a real webhook. Staging uses
# the same n8n workflows as production, which route is_test leads to the TEST sheet and stop
# before every partner (docs/PIPELINE.md, ADR 0011), through /webhook/<path> (never n8n's
# /webhook-test/ editor URL, which only answers while someone listens in the editor; see
# docs/ops/ploi-staging.md). On staging/production the URLs must be https and the secret is
# required with them (at least 16 characters; sent as X-VV-Secret).
N8N_LEAD_WEBHOOK_URL=
# Newsletter sign-ups; defaults to the lead webhook (payload type "newsletter").
N8N_NEWSLETTER_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Cloudflare Turnstile. Required on production (a real key; the test keys are refused there).
# Without it, local, CI and staging verify with Cloudflare's always-passing test secret
# 1x0000000000000000000000000000000AA; the matching test site key is 1x00000000000000000000AA.
TURNSTILE_SECRET_KEY=
# The site key the pages render the widget with (public, fixed at build time). Required on
# production (a real key; the test keys are refused there); without it the other environments
# use the always-passing test site key 1x00000000000000000000AA.
PUBLIC_TURNSTILE_SITE_KEY=
# Local and CI only: a stand-in for Cloudflare's siteverify (the e2e mock server sets it).
# TURNSTILE_VERIFY_URL=

# Phase 6
# PUBLIC_GTM_ID=
